# Base locale du restaurant (PostgreSQL 16)
DATABASE_URL=postgres://localhost:5432/pos_samer
# Base d'administration utilisée pour créer la base si absente
ADMIN_DATABASE_URL=postgres://localhost:5432/postgres
# Port du serveur local
PORT=3001

# ---- Sprint 3 : synchronisation cloud (Supabase) ----
# URL de base des Edge Functions du projet cloud, fournie par le siège.
# Ex : https://xxxxxxxx.supabase.co/functions/v1
SUPABASE_SYNC_URL=
# Clé de site (générée par `pnpm site:enroler`). Si vide, lue depuis
# parametres_locaux.cle_site. Ne JAMAIS committer une vraie clé.
CLE_SITE=
# Intervalles (secondes) : montée des ventes / descente du catalogue.
SYNC_INTERVALLE_MONTEE=30
SYNC_INTERVALLE_DESCENTE=300
# Mettre à 0 pour désactiver la synchro (dev/tests).
SYNC_ACTIF=1
