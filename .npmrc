# Structure de node_modules SANS liens symboliques (comme npm).
#
# Par défaut, pnpm bâtit node_modules avec ~2 500 liens symboliques pointant
# vers .pnpm/. C'est plus économe sur un poste de développement, mais ce dossier
# est DUPLIQUÉ SUR CLÉ USB puis sur les 7 restaurants : or les outils de copie
# Windows ne recréent ces liens qu'avec des droits administrateur (robocopy /SL,
# incompatible avec /MT), et une copie ratée produit des paquets absents —
# l'application ne démarre alors plus du tout, sans message clair.
#
# En « hoisted », node_modules ne contient que de vrais dossiers : n'importe
# quel outil de copie fait l'affaire, y compris le glisser-déposer de
# l'explorateur Windows.
node-linker=hoisted
